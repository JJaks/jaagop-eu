{
	"name": "jaagop-eu",
	"private": true,
	"version": "2025.10.3",
	"type": "module",
	"engines": {
		"node": "26.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"version:today": "node scripts/version.js today",
		"version:patch": "node scripts/version.js patch",
		"version:help": "node scripts/version.js help",
		"release": "npm run version:today && npm run build",
		"release:patch": "npm run version:patch && npm run build",
		"lighthouse": "node scripts/lighthouse.js",
		"lighthouse:build": "node scripts/lighthouse.js --build --preview",
		"lighthouse:production": "node scripts/lighthouse.js --production https://jaagop.eu",
		"lighthouse:budget": "node scripts/lighthouse.js --budget"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"marked": "^18.1.3"
	},
	"packageManager": "pnpm@12.18.0",
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
